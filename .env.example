# Core LLM Provider
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_TEXT_MODEL=qwen3.5-plus

# Storage Provider (current implementation keeps Aliyun-compatible env vars)
STORAGE_PROVIDER=aliyun_oss
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PREFIX=lapian-temp/
STORAGE_UPLOAD_URL_TTL_SECONDS=900

# Phase 9: Auth & Database
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-random-secret
# 本地开发通常不需要 AUTH_URL
# 生产环境设置 AUTH_URL=https://chaosx.top
AUTH_TRUST_HOST=true
DATA_ENCRYPTION_KEY=replace-with-random-32-byte-key

# Lapian MVP
# Backward-compatible Aliyun storage envs used by current OSS implementation
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_PREFIX=lapian-temp/
ALIYUN_OSS_UPLOAD_URL_TTL_SECONDS=900

# Aliyun IMS Subtitle Smoke Test
ALIYUN_IMS_REGION=cn-shanghai
ALIYUN_IMS_ENDPOINT=ice.cn-shanghai.aliyuncs.com
ALIYUN_IMS_PIPELINE_ID=
ALIYUN_IMS_ASR_OUTPUT_PREFIX=lapian-processed/asr/
ALIYUN_IMS_MAX_SINGLE_COST=1
ALIYUN_IMS_ENABLE_REAL_CALL=false
ALIYUN_VIDEO_OCR_ENDPOINT=videorecog.cn-shanghai.aliyuncs.com
# SUBTITLE_PROVIDER=uploaded_subtitle_file
# DEEP_ANALYSIS_PROVIDER=custom_llm_worker
LAPIAN_RAW_RETENTION_HOURS=24
LAPIAN_WORKER_TOKEN=

# Community landing page
NEXT_PUBLIC_COMMUNITY_WECHAT_QR_URL=
NEXT_PUBLIC_COMMUNITY_FEISHU_DOCS_URL=
NEXT_PUBLIC_COMMUNITY_GITHUB_URL=https://github.com/hehome200/1TiStory
NEXT_PUBLIC_COMMUNITY_WAITLIST_URL=
NEXT_PUBLIC_COMMUNITY_TEMPLATE_DOWNLOAD_URL=
NEXT_PUBLIC_COMMUNITY_CONTACT_EMAIL=
